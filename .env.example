# Turso Edge Database — https://turso.tech
# 1. Create a database: turso db create my-repurposer
# 2. Get the URL:       turso db show my-repurposer --url
# 3. Create a token:    turso db tokens create my-repurposer
TURSO_DATABASE_URL=libsql://your-db-name-yourname.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Optional: Add Clerk keys here when ready for real auth
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
